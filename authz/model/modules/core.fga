module core

type user

# Mirrors one IdP (e.g. Entra) security group. Membership tuples are written
# only by the identity sync service - never by hand. In contextual (Option B)
# mode no group tuples are persisted at all; the type restriction still permits
# them, which is what lets both modes share one model.
type group
  relations
    define member: [user, group#member]

# Singleton object, e.g. platform:main. Super admins are the core platform team
# and span every tenant (tenants compute super_admin from here).
type platform
  relations
    define super_admin: [user, group#member]

# One tenant per team. Isolation is structural: a check succeeds only if a
# tuple path exists, so members of tenant A have no path to tenant B's objects.
# The studio role ladder (admin > developer > analyst) lives here; `member` is
# the marketplace-profile general role and is kept for that profile.
#
# Nested tenants (optional): a tenant may have a `parent` tenant, e.g.
# tenant:division parent tenant:team-a. Roles flow DOWN - an admin/developer/analyst/
# member of the parent holds the same role in every child (recursively) - and a
# child reaches the platform's super admins through its parent, so it needs no
# platform link of its own. Roles never flow up or sideways. A tenant with no
# parent behaves exactly as before. Parent tuples must not form a cycle.
type tenant
  relations
    define platform: [platform]
    define parent: [tenant]
    define admin: [user, group#member] or admin from parent
    define developer: [user, group#member] or developer from parent
    define analyst: [user, group#member] or analyst from parent
    define member: [user, group#member] or admin or member from parent
    define super_admin: super_admin from platform or super_admin from parent
    define can_administer: admin or super_admin
    # creating a network or tool is a tenant-scoped question ("create WHAT, WHERE"),
    # so the create verb of the ladder matrix is checked here, not on a not-yet-
    # existing resource object: analyst excluded. This is the ONE create relation -
    # a prior second relation (can_create_network: member or super_admin) was
    # removed because it disagreed with the ladder (granted bare members, denied
    # developers). Everything checks can_create_resources.
    define can_create_resources: admin or developer or super_admin
