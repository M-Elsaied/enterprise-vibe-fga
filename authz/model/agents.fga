module agents

# The object id of an agent_network MUST equal the served network name
# (the .hocon filename stem) - that is the id the neuro-san runtime hands
# to the authorizer on every check. Convention: <tenant-slug>--<network-slug>.
type agent_network
  relations
    define tenant: [tenant]                      # owning team; written on create
    define builder: [user]                       # creator; written on create
    define editor: [user, group#member] or builder or admin from tenant
    # THE marketplace relation:
    #   user:*          -> published platform-wide
    #   tenant:X#member -> shared to one specific tenant
    define published_to: [user:*, tenant#member]
    # The single relation the neuro-san runtime checks on every request
    # (AGENT_AUTHORIZER_ALLOW_RELATION=can_invoke). Direct [user] exists for
    # exceptional grants and for user:system (the periodic event watcher).
    define can_invoke: [user] or editor or member from tenant or published_to or super_admin from tenant
    define can_edit: editor or super_admin from tenant
    define can_publish: admin from tenant or super_admin from tenant
    define can_delete: builder or admin from tenant or super_admin from tenant
